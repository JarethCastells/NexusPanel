async function cargarPendientes() {
    try {
        const res  = await fetch('../api/pedido.php?action=pedidos_pendientes');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (!Array.isArray(data)) throw new Error('Respuesta invÃƒÂ¡lida');
        const grid = document.getElementById('pendientesGrid');
        document.getElementById('tabBadgePendientes').textContent = data.length;

        if (!data.length) {
            grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text-muted);">
                <i class="fa-solid fa-check-circle" style="font-size:40px;opacity:0.2;display:block;margin-bottom:16px;color:var(--success);"></i>
                <p>No hay pedidos pendientes en tu zona</p>
            </div>`;
            return;
        }

        grid.innerHTML = data.map(p => `
            <div class="pendiente-card">
                <div class="pc-header">
                    <span class="pedido-num">#${p.id}</span>
                    ${p.distancia_km !== null ? `<span class="distancia-badge"><i class="fa-solid fa-route"></i> ${p.distancia_km} km</span>` : ''}
                </div>
                <div class="pc-cliente">
                    <div class="pc-avatar">${p.cliente_nombre.charAt(0).toUpperCase()}</div>
                    <div>
                        <strong>${p.cliente_nombre}</strong>
                        <div style="font-size:12px;color:var(--text-muted)">${p.cli_tel||''}</div>
                    </div>
                </div>
                <div class="pc-domicilio">
                    <i class="fa-solid fa-location-dot" style="color:var(--primary)"></i>
                    ${p.domicilio_entrega||p.cli_dom||'Sin direcciÃƒÂ³n'}
                </div>
                <div class="pc-total">$${parseFloat(p.total).toFixed(2)} MXN</div>
                <div class="pc-fecha">${new Date(p.created_at).toLocaleString('es-MX')}</div>
                <button class="btn-tomar" onclick="tomarPedido(${p.id})">
                    <i class="fa-solid fa-hand"></i> Tomar este pedido
                </button>
            </div>
        `).join('');
    } catch(e) {
        document.getElementById('tabBadgePendientes').textContent = '!';
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬ TOMAR PEDIDO Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
async function tomarPedido(id) {
    if (!confirm('Ã‚Â¿Deseas tomar este pedido?')) return;
    const btn = event.currentTarget;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Tomando...';
    try {
        const res  = await fetch(`../api/pedido.php?action=aceptar&pedido_id=${id}`, {method:'POST'});
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.success) {
            // PequeÃƒÂ±a pausa para que la BD confirme antes de redirigir
            await new Promise(r => setTimeout(r, 500));
            window.location.href = `operador_pedidos.php?tab=activos&pedido_id=${id}`;
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-hand"></i> Tomar este pedido';
            alert('Error: ' + (data.error || 'No se pudo tomar el pedido. Puede que otro operador lo tomÃƒÂ³ primero.'));
            cargarPendientes(); // Refrescar lista
        }
    } catch(e) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-hand"></i> Tomar este pedido';
        alert('Error de conexiÃƒÂ³n al tomar el pedido.');
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬ MAPA OPERADOR Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
function initMapaOperador() {
    const el = document.getElementById('mapaOperador'); if(!el)return;
    map = L.map('mapaOperador');
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OSM',maxZoom:19}).addTo(map);

    if (CLI_LAT && CLI_LNG) {
